<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- 状态栏 -->
    <LinearLayout
        android:id="@+id/layoutStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_settings"
            android:layout_marginEnd="8dp" />

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_stopped"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:letterSpacing="0.05" />

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ProgressBar
                android:id="@+id/unlockProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/circular_progress"
                android:max="2000"
                android:progress="0"
                android:clickable="false"
                android:focusable="false" />

            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_lock"
                android:clickable="false"
                android:focusable="false" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lock screen"
                android:text="" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#262626"
        android:layout_marginBottom="8dp" />

    <!-- 步频环形仪表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="8dp">

        <com.runbeat.pro.CadenceRingView
            android:id="@+id/cadenceRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/desc_cadence" />

        <!-- 宽 224dp = 标签 52 + 间距 10 + 数值 100 + 右侧留白 62；
             数值列中心恒定落在环心，不随文字宽度漂移 -->
        <LinearLayout
            android:id="@+id/layoutCadenceTap"
            android:layout_width="224dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLabelPrimary"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/label_bpm"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPrimaryValue"
                    android:layout_width="100dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="180.0"
                    android:textColor="@color/textPrimary"
                    android:textSize="62sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTargetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLabelTarget"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/label_target_word"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTargetValue"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="180.0"
                    android:textColor="@color/targetValue"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCadenceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/msg_start_for_cadence"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 计时器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Space
            android:layout_width="44dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="@color/textTimer"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↻"
            android:textColor="@color/textSecondary"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/btn_bpm_control"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 步数 / 统计入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnStats"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/label_stats"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- BPM 微调 -->
    <LinearLayout
        android:id="@+id/layoutBpmControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnBpmMinus5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="-5"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:background="@drawable/btn_bpm_control"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBpmMinus1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="-1"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:background="@drawable/btn_bpm_control"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBpmPlus1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="+1"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:background="@drawable/btn_bpm_control"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBpmPlus5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="+5"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:background="@drawable/btn_bpm_control" />

    </LinearLayout>

    <!-- 启停 -->
    <Button
        android:id="@+id/btnStartPause"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:background="@drawable/btn_start_pause"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#262626"
        android:layout_marginBottom="8dp" />

    <!-- 音量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTickVolumeLabel"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/label_volume"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekTickVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnGain"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="x1"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/btn_bpm_control_ripple"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
</ScrollView>

<include
    layout="@layout/drawer_settings"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
