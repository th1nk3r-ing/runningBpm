<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="12dp">

    <!-- 状态区：运行指示灯 + 文字 + 锁定按钮 -->
    <LinearLayout
        android:id="@+id/layoutStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STOPPED"
            android:textColor="@color/textPrimary"
            android:textSize="20sp" />

        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="92dp">

            <ProgressBar
                android:id="@+id/unlockProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:progressDrawable="@drawable/circular_progress"
                android:max="2000"
                android:progress="0"
                android:clickable="false"
                android:focusable="false" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:text="🔓"
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/btn_lock" />
        </FrameLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <!-- 计时区 -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="@color/textPrimary"
        android:textSize="40sp"
        android:typeface="monospace"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- BPM 核心区（数字 + BPM 标签并排） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvBpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="180"
            android:textColor="@color/textPrimary"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBpmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BPM"
            android:textColor="@color/colorPrimary"
            android:textSize="20sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <!-- 调节区：[-5] [-1] [+1] [+5] -->
    <LinearLayout
        android:id="@+id/layoutBpmControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBpmMinus5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="-5"
            android:textSize="18sp"
            android:background="@drawable/btn_bpm_control" />

        <Button
            android:id="@+id/btnBpmMinus1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="-1"
            android:textSize="18sp"
            android:background="@drawable/btn_bpm_control" />

        <Button
            android:id="@+id/btnBpmPlus1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="+1"
            android:textSize="18sp"
            android:background="@drawable/btn_bpm_control" />

        <Button
            android:id="@+id/btnBpmPlus5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="+5"
            android:textSize="18sp"
            android:background="@drawable/btn_bpm_control" />
    </LinearLayout>

    <!-- 控制区：START / PAUSE -->
    <Button
        android:id="@+id/btnStartPause"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="START"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/btn_start_pause"
        android:layout_marginBottom="16dp" />

    <!-- 参数区：音量单独一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTickVolumeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tick Vol"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/sbTickVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:thumbTint="@color/colorPrimary"
            android:progressTint="@color/colorPrimary" />
    </LinearLayout>

    <!-- 参数区：Accent + 音色 -->
    <LinearLayout
        android:id="@+id/layoutParams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvAccentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accent"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Switch
            android:id="@+id/switchAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumbTint="@color/colorPrimary"
            android:trackTint="@color/colorPrimaryVariant" />

        <Button
            android:id="@+id/btnTimbre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音色"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:background="@drawable/btn_bpm_control"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBuildInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="11sp"
        android:paddingBottom="4dp" />

</LinearLayout>
